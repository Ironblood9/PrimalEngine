<UserControl x:Class="PrimalEngineEditor.AllEditors.WorldEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:PrimalEngineEditor.AllEditors"
             xmlns:utl="clr-namespace:PrimalEngineEditor.Utilities"
             mc:Ignorable="d" Focusable="True"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding RedoCommand}" Key="Y" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            
            <Button Content="Undo" Command="{Binding UndoCommand}"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="20,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Top" Background="Transparent"/>
                <TabControl Grid.Row="1" Background="{DynamicResource Editor.Window.GrayBrush2}" Margin="0,5,0,0">
                    <TabItem Header="History">
                        <utl:UndoRedoWindow DataContext="{Binding UndoRedo}"  />
                        
                    </TabItem>
                    <TabItem Header="Log">
                        <utl:LoggerWindow/>
                    </TabItem>
                    
                </TabControl>
                
            </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Left" 
                      VerticalAlignment="Stretch" Background="Transparent"/>
        <Grid Grid.Column="1" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Top" Background="Transparent"/>
            <local:ProjectLayoutWindow Background="{DynamicResource Editor.Window.GrayBrush3}"/>
                <local:GameEntityWindow Grid.Row="1" Background="{DynamicResource Editor.Window.GrayBrush3}" Margin="0,5,0,0"/>
            </Grid>
       </Grid>
    </Grid>
</UserControl>
