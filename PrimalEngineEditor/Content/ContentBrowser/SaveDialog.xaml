<Window x:Class="PrimalEngineEditor.Content.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrimalEngineEditor.Content"
        mc:Ignorable="d" Foreground="{DynamicResource Editor.FontBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Title="Save" Height="600" Width="800" MinWidth="600" MinHeight="400"
        Style="{StaticResource AgilisWindowStyle}"
        Background="#121827">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Content Browser -->
        <Border Style="{StaticResource NeonCard}">
            <local:ContentBrowserWindow x:Name="contentBrowserView"
                                        SelectionMode="Single"
                                        FileAccess="Write"
                                        AllowDrop="False"
                                        MouseDoubleClick="OnContentBrowser_Mouse_Double_Click"/>

        </Border>

        <!-- Bottom Panel -->
        <Border Grid.Row="1" Style="{StaticResource NeonCard}" Margin="0,10,0,0">
            <StackPanel>
                <!-- File name input -->
                <DockPanel Margin="10" LastChildFill="True">
                    <TextBlock Text="File name:" 
                               Style="{StaticResource LightTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="fileNameTextBox"
                             Style="{StaticResource NeonTextBox}"
                             Text="{Binding Path=SelectedItem.FileName, ElementName=contentBrowserView, Mode=OneWay}"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Stretch"
                             DockPanel.Dock="Right"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="10,0,11,10">
                    <Button Content="Save"
                            Width="96"
                            IsDefault="True"
                            Click="OnSave_Button_Click"
                            Style="{StaticResource NeonButton}"/>
                    <Button Content="Cancel"
                            Width="96"
                            Margin="32,0,0,0"
                            IsCancel="True"
                            Style="{StaticResource NeonButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>



