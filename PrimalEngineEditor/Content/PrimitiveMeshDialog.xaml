<Window x:Class="PrimalEngineEditor.Content.PrimitiveMeshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrimalEngineEditor.Content"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:utl="clr-namespace:PrimalEngineEditor.Utilities.Controls"
        xmlns:ed="clr-namespace:PrimalEngineEditor.AllEditors"
        mc:Ignorable="d" ResizeMode="NoResize"
        Foreground="{DynamicResource Editor.FontBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" 
        Title="Primitive Mesh" Height="600" Width="800"
        Style="{StaticResource AgilisDialogStyle}">

    <Window.DataContext>
        <ed:GeometryEditor/>
    </Window.DataContext>

    <Window.Resources>
        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:PrimitiveMeshType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel Background="{DynamicResource Editor.Window.GrayBrush2 }">
        <Border Background="{DynamicResource Editor.Window.GrayBrush3}" Height="32" DockPanel.Dock="Top"
                VerticalAlignment="Top" Margin="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <ComboBox SelectedIndex="2" Width="100" VerticalAlignment="Center" 
                          ItemsSource="{Binding Source={StaticResource dataFromEnum}}" x:Name="primTypeComboBox"
                          SelectionChanged="OnPrimitiveType_ComboBox_SelectionChanged"/>
                <CheckBox x:Name="textureCheckBox" Content="Show textured" VerticalAlignment="Center" Margin="5,0" IsChecked="True"
                          Foreground="{DynamicResource Editor.FontBrush}"
                          Click="OnTexture_CheckBox_Click"/>
            </StackPanel> 
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" MaxWidth="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

          
            <!--  PLANE SETTINGS -->
            <StackPanel Background="#0B0F1A">

                <!-- Segments -->
                <Border Style="{StaticResource NeonCard}">
                    <StackPanel>
                        <TextBlock Text="Segments" Foreground="#A6F6FF" FontWeight="Bold" FontSize="14"/>
                        <DockPanel Margin="5">
                            <TextBlock Text="Width" Width="60" Foreground="#66FFFF"/>
                            <TextBox Text="{Binding Path=Value, ElementName=xSliderPlane}" Width="40" Margin="10,0" />
                            <Slider x:Name="xSliderPlane" Minimum="1" Maximum="10" Interval="1"
                                    IsSnapToTickEnabled="True" ValueChanged="OnSlider_ValueChanged"
                                    Style="{StaticResource BlueSlider}"/>
                        </DockPanel>
                        <DockPanel Margin="5">
                            <TextBlock Text="Length" Width="60" Foreground="#66FFFF"/>
                            <TextBox Text="{Binding Path=Value, ElementName=zSliderPlane}" Width="40" Margin="10,0"/>
                            <Slider x:Name="zSliderPlane" Minimum="1" Maximum="10" Interval="1"
                                    IsSnapToTickEnabled="True" ValueChanged="OnSlider_ValueChanged"
                                    Style="{StaticResource BlueSlider}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Size -->
                <Border Style="{StaticResource NeonCard}">
                    <StackPanel>
                        <TextBlock Text="Size" Foreground="#A6F6FF" FontWeight="Bold" FontSize="14"/>
                        <DockPanel Margin="5">
                            <TextBlock Text="Width" Width="60" Foreground="#66FFFF"/>
                            <utl:ScalarBox x:Name="widthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="5">
                            <TextBlock Text="Length" Width="60" Foreground="#66FFFF"/>
                            <utl:ScalarBox x:Name="lengthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="Save" Width="96" Margin="5,0" Click="OnSave_Button_Click"
                        Style="{StaticResource NeonButton}"/>
            </StackPanel>
            <!--  CUBE SETTINGS -->
            <!--  UVSPHERE SETTINGS -->
            <StackPanel Background="#0B0F1A">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=primTypeComboBox}" 
                                         Value="{x:Static local:PrimitiveMeshType.UvSphere}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Segments -->
                <Border Style="{StaticResource NeonCard}">
                    <StackPanel>
                        <TextBlock Text="Segments" Foreground="#A6F6FF" FontWeight="Bold" FontSize="14"/>
                        <DockPanel Margin="5">
                            <TextBlock Text="Lon." Width="60" Foreground="#66FFFF"/>
                            <TextBox Text="{Binding Path=Value, ElementName=xSliderUvSphere}" Width="40" Margin="10,0" />
                            <Slider x:Name="xSliderUvSphere" Minimum="3" Maximum="64" Value="24" Interval="1"
                        IsSnapToTickEnabled="True" ValueChanged="OnSlider_ValueChanged" 
                        Style="{StaticResource BlueSlider}"/>
                        </DockPanel>
                        <DockPanel Margin="5">
                            <TextBlock Text="Lat." Width="60" Foreground="#66FFFF"/>
                            <TextBox Text="{Binding Path=Value, ElementName=ySliderUvSphere}" Width="40" Margin="10,0"/>
                            <Slider x:Name="ySliderUvSphere" Minimum="2" Maximum="64" Value="12" Interval="1"
                        IsSnapToTickEnabled="True" ValueChanged="OnSlider_ValueChanged"
                        Style="{StaticResource BlueSlider}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Size -->
                <Border Style="{StaticResource NeonCard}">
                    <StackPanel>
                        <TextBlock Text="Size" Foreground="#A6F6FF" FontWeight="Bold" FontSize="14"/>
                        <DockPanel Margin="5">
                            <TextBlock Text="X" Width="60" Foreground="#66FFFF"/>
                            <utl:ScalarBox x:Name="xScalarBoxUvSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="5">
                            <TextBlock Text="Y" Width="60" Foreground="#66FFFF"/>
                            <utl:ScalarBox x:Name="yScalarBoxUvSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="5">
                            <TextBlock Text="Z" Width="60" Foreground="#66FFFF"/>
                            <utl:ScalarBox x:Name="zScalarBoxUvSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <!--Smoothing Angles-->
                <Border Style="{StaticResource NeonCard}">
                    <StackPanel>
                        <TextBlock Text="Smoothing Angels" Foreground="#A6F6FF" FontWeight="Bold" FontSize="14"/>
                        <DockPanel Margin="5,15,5,5">
                            <TextBlock Text="Angle" Width="60" Foreground="#66FFFF"/>
                            <TextBox Text="{Binding Path=Value, ElementName=angleSliderUvSphere}" Width="40" Margin="10,0" />
                            <Slider x:Name="angleSliderUvSphere" Minimum="0" Maximum="180" 
                                    IsSnapToTickEnabled="True" ValueChanged="OnSlider_ValueChanged"
                                    Style="{StaticResource BlueSlider}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="Save" Width="96" Margin="5,0"  Click="OnSave_Button_Click"
                        Style="{StaticResource NeonButton}"/>
            </StackPanel>
            <!--  ICOSPHERE SETTINGS -->
            <!--  CYLINDER SETTINGS -->
            <!--  CAPSULE SETTINGS -->
            <ed:GeometryWindow DataContext="{Binding MeshRenderer}" Grid.Column="1"/>
            <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MeshRenderer.CameraPosition.X, StringFormat=G5}" Foreground="{DynamicResource Editor.RedBrush}"/>
                <TextBlock Text="{Binding MeshRenderer.CameraPosition.Y, StringFormat=G5}" Margin="10,0" Foreground="{DynamicResource Editor.GreenBrush}"/>
                <TextBlock Text="{Binding MeshRenderer.CameraPosition.Z, StringFormat=G5}" Foreground="{DynamicResource Editor.BlueBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MeshRenderer.Meshes[0].Positions.Count}" Foreground="{DynamicResource Editor.OrangeBrush}"/>
                <TextBlock Text="{Binding MeshRenderer.Meshes[0].Indices.Count}" Margin="10,0" Foreground="{DynamicResource Editor.OrangeBrush}"/>
            </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
